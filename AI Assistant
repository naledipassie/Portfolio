<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Desk — AI Productivity Assistant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#14171F;
    --ink-2:#1C2130;
    --panel:#232A3D;
    --paper:#EDE7D9;
    --paper-2:#F6F2E8;
    --amber:#E8A33D;
    --amber-dim:#B87F2A;
    --slate:#8B92A5;
    --white:#F5F3EE;
    --line: rgba(237,231,217,0.14);
    --radius: 3px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: var(--ink);
    color: var(--white);
    font-family:'Inter', sans-serif;
    min-height:100vh;
  }
  ::selection{ background: var(--amber); color: var(--ink); }

  .app{
    display:flex;
    min-height:100vh;
  }

  /* ---------- Sidebar ---------- */
  .sidebar{
    width:240px;
    flex-shrink:0;
    background: var(--ink-2);
    border-right:1px solid var(--line);
    display:flex;
    flex-direction:column;
    padding:24px 0;
  }
  .brand{
    padding: 0 20px 20px 20px;
    border-bottom:1px solid var(--line);
    margin-bottom:8px;
  }
  .brand-mark{
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    letter-spacing:0.14em;
    color: var(--amber);
    text-transform:uppercase;
  }
  .brand-title{
    font-family:'Fraunces', serif;
    font-size:22px;
    font-weight:600;
    line-height:1.15;
    margin-top:6px;
  }
  .brand-sub{
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    color: var(--slate);
    margin-top:8px;
    line-height:1.5;
  }

  .stations{
    display:flex;
    flex-direction:column;
    padding: 8px 10px;
    gap:2px;
  }
  .station-btn{
    display:flex;
    align-items:center;
    gap:12px;
    text-align:left;
    background:transparent;
    border:none;
    color: var(--slate);
    font-family:'Inter', sans-serif;
    font-size:13.5px;
    font-weight:500;
    padding:11px 12px;
    border-radius: var(--radius);
    cursor:pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .station-btn .code{
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    letter-spacing:0.06em;
    width:34px;
    flex-shrink:0;
    color: var(--amber-dim);
  }
  .station-btn:hover{ background: rgba(232,163,61,0.06); color: var(--white); }
  .station-btn.active{ background: rgba(232,163,61,0.1); color: var(--white); }
  .station-btn.active .code{ color: var(--amber); }

  .sidebar-foot{
    margin-top:auto;
    padding: 16px 20px 4px 20px;
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    color: var(--slate);
    border-top:1px solid var(--line);
  }

  /* ---------- Main ---------- */
  .main{
    flex:1;
    padding: 40px 48px;
    max-width: 900px;
  }
  .station-head{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    margin-bottom: 26px;
    padding-bottom:16px;
    border-bottom:1px solid var(--line);
  }
  .station-head h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size: 30px;
    margin:0;
  }
  .station-head .desc{
    font-family:'Inter';
    font-size:13px;
    color: var(--slate);
    margin-top:6px;
  }
  .station-head .tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color: var(--amber);
    border:1px solid var(--amber-dim);
    padding:4px 9px;
    border-radius:20px;
    white-space:nowrap;
  }

  label{
    display:block;
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    letter-spacing:0.05em;
    text-transform:uppercase;
    color: var(--slate);
    margin-bottom:6px;
    margin-top:16px;
  }
  label:first-child{ margin-top:0; }
  input[type=text], textarea, select{
    width:100%;
    background: var(--panel);
    border:1px solid var(--line);
    color: var(--white);
    font-family:'Inter';
    font-size:14px;
    padding:11px 12px;
    border-radius: var(--radius);
    resize:vertical;
  }
  input[type=text]:focus, textarea:focus, select:focus{
    outline:none;
    border-color: var(--amber-dim);
  }
  textarea{ min-height:110px; line-height:1.5; }
  select{ appearance:none; cursor:pointer; }

  .row{ display:flex; gap:16px; }
  .row > div{ flex:1; }

  .run-btn{
    margin-top:22px;
    background: var(--amber);
    color: var(--ink);
    border:none;
    font-family:'Inter';
    font-weight:600;
    font-size:14px;
    padding:12px 22px;
    border-radius: var(--radius);
    cursor:pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .run-btn:hover{ background:#F2B15C; }
  .run-btn:active{ transform: scale(0.98); }
  .run-btn:disabled{ background: var(--slate); cursor:not-allowed; }

  /* ---------- Ticket (output) ---------- */
  .ticket-wrap{ margin-top:30px; }
  .ticket{
    background: var(--paper);
    color:#20241B;
    border-radius:2px;
    position:relative;
    padding: 26px 28px 24px 28px;
    font-family:'Inter';
    box-shadow: 0 14px 30px rgba(0,0,0,0.35);
  }
  .ticket::before{
    content:"";
    position:absolute;
    top:-7px; left:0; right:0; height:14px;
    background-image: radial-gradient(circle, var(--ink) 4px, transparent 4.5px);
    background-size: 18px 14px;
    background-repeat: repeat-x;
    background-position: 6px 0;
  }
  .ticket-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    border-bottom:1px dashed rgba(32,36,27,0.3);
    padding-bottom:12px;
    margin-bottom:16px;
  }
  .ticket-head .label{
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:#6b6650;
  }
  .ticket-head .status{
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    letter-spacing:0.06em;
    color: var(--amber-dim);
    border:1px solid var(--amber-dim);
    padding:3px 8px;
    border-radius:20px;
  }
  .ticket-body{
    font-size:14.5px;
    line-height:1.65;
    white-space:pre-wrap;
  }
  .ticket-body h1,.ticket-body h2,.ticket-body h3{ font-family:'Fraunces',serif; margin:14px 0 6px; }
  .ticket-body strong{ color:#14171F; }
  .ticket-body ul, .ticket-body ol{ padding-left:20px; }
  .ticket-body code{ background: rgba(32,36,27,0.08); padding:1px 5px; border-radius:3px; font-family:'IBM Plex Mono', monospace; font-size:13px; }

  .copy-btn{
    margin-top:14px;
    background:transparent;
    border:1px solid rgba(32,36,27,0.35);
    color:#20241B;
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    padding:7px 12px;
    border-radius:20px;
    cursor:pointer;
  }
  .copy-btn:hover{ background: rgba(32,36,27,0.06); }

  .empty-note{
    margin-top:30px;
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px;
    color: var(--slate);
    border-left:2px solid var(--line);
    padding-left:12px;
    line-height:1.6;
  }

  .loading{
    margin-top:30px;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color: var(--amber);
    display:flex;
    align-items:center;
    gap:10px;
  }
  .dot{
    width:6px;height:6px;border-radius:50%;
    background: var(--amber);
    animation: pulse 1s infinite ease-in-out;
  }
  .dot:nth-child(2){ animation-delay:0.15s; }
  .dot:nth-child(3){ animation-delay:0.3s; }
  @keyframes pulse{ 0%,100%{ opacity:0.25; } 50%{ opacity:1; } }

  .error{
    margin-top:22px;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:#E8683D;
    border-left:2px solid #E8683D;
    padding-left:12px;
  }

  /* ---------- Chat ---------- */
  .chat-log{
    margin-top:22px;
    display:flex;
    flex-direction:column;
    gap:14px;
    max-height:480px;
    overflow-y:auto;
    padding-right:4px;
  }
  .msg{ max-width:78%; }
  .msg.user{ align-self:flex-end; }
  .msg.assistant{ align-self:flex-start; }
  .msg .bubble{
    padding:11px 14px;
    border-radius:3px;
    font-size:14px;
    line-height:1.55;
    white-space:pre-wrap;
  }
  .msg.user .bubble{ background: var(--panel); border:1px solid var(--line); }
  .msg.assistant .bubble{ background: var(--paper); color:#20241B; }
  .msg .who{
    font-family:'IBM Plex Mono', monospace;
    font-size:9.5px;
    color: var(--slate);
    text-transform:uppercase;
    letter-spacing:0.06em;
    margin-bottom:4px;
  }
  .msg.user .who{ text-align:right; }
  .chat-input-row{
    display:flex;
    gap:10px;
    margin-top:16px;
  }
  .chat-input-row textarea{ min-height:44px; }
  .chat-input-row .run-btn{ margin-top:0; align-self:flex-end; height:44px; }

  @media (max-width: 760px){
    .app{ flex-direction:column; }
    .sidebar{ width:100%; flex-direction:row; overflow-x:auto; padding:14px; }
    .brand{ display:none; }
    .stations{ flex-direction:row; padding:0; }
    .station-btn .code{ display:none; }
    .sidebar-foot{ display:none; }
    .main{ padding:26px 20px; }
  }

  a{ color: var(--amber); }
  ::-webkit-scrollbar{ width:8px; }
  ::-webkit-scrollbar-thumb{ background: var(--panel); border-radius:8px; }
</style>
</head>
<body>

<div class="app">
  <div class="sidebar">
    <div class="brand">
      <div class="brand-mark">Workplace Desk</div>
      <div class="brand-title">Productivity<br>Assistant</div>
      <div class="brand-sub">Five stations. One desk.<br>Pick a task to begin.</div>
    </div>
    <div class="stations" id="stationNav"></div>
    <div class="sidebar-foot">Powered by Claude<br>All work stays in-browser</div>
  </div>

  <div class="main" id="main"></div>
</div>

<script>
const STATIONS = [
  { id:'email', code:'EM·1', name:'Email Drafting', desc:'Turn a few bullet points into a ready-to-send email.' },
  { id:'meeting', code:'MT·2', name:'Meeting Summary', desc:'Paste notes or a transcript — get a clean summary and action items.' },
  { id:'tasks', code:'TP·3', name:'Task Planning', desc:'Break a goal into an ordered, doable task list.' },
  { id:'research', code:'RS·4', name:'Research Assist', desc:'Ask a question — Claude searches the live web and reports back.' },
  { id:'chat', code:'CH·5', name:'Chat Assistant', desc:'A general-purpose chat for anything else on your desk.' },
];

let current = 'email';
let chatHistory = [];

function renderNav(){
  const nav = document.getElementById('stationNav');
  nav.innerHTML = STATIONS.map(s => `
    <button class="station-btn ${s.id===current?'active':''}" data-id="${s.id}">
      <span class="code">${s.code}</span><span>${s.name}</span>
    </button>
  `).join('');
  nav.querySelectorAll('.station-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      current = btn.dataset.id;
      renderNav();
      renderMain();
    });
  });
}

async function callClaude({system, messages, tools}){
  const body = {
    model: "claude-sonnet-4-6",
    max_tokens: 1000,
    messages
  };
  if(system) body.system = system;
  if(tools) body.tools = tools;

  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method:"POST",
    headers:{ "Content-Type":"application/json" },
    body: JSON.stringify(body)
  });
  if(!res.ok){
    throw new Error("Request failed (" + res.status + ")");
  }
  const data = await res.json();
  const text = (data.content || [])
    .map(block => block.type === "text" ? block.text : "")
    .filter(Boolean)
    .join("\n");
  return text || "(no response text returned)";
}

// very small markdown-ish renderer for headings/bold/lists
function renderRichText(text){
  let html = text
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/^### (.*$)/gim,'<h3>$1</h3>')
    .replace(/^## (.*$)/gim,'<h2>$1</h2>')
    .replace(/^# (.*$)/gim,'<h1>$1</h1>')
    .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')
    .replace(/`([^`]+)`/g,'<code>$1</code>');
  // lists
  html = html.replace(/(^|\n)- (.*)/g, '$1<li>$2</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/g, m => '<ul>'+m+'</ul>');
  return html;
}

function ticketTemplate({label, status, bodyHtml}){
  return `
    <div class="ticket-wrap">
      <div class="ticket">
        <div class="ticket-head">
          <span class="label">${label}</span>
          <span class="status">${status}</span>
        </div>
        <div class="ticket-body">${bodyHtml}</div>
        <button class="copy-btn" id="copyBtn">Copy text</button>
      </div>
    </div>
  `;
}

function wireCopy(rawText){
  const btn = document.getElementById('copyBtn');
  if(!btn) return;
  btn.addEventListener('click', ()=>{
    navigator.clipboard.writeText(rawText);
    btn.textContent = 'Copied';
    setTimeout(()=> btn.textContent = 'Copy text', 1400);
  });
}

function loadingHtml(msg){
  return `<div class="loading"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp;${msg}</div>`;
}
function errorHtml(msg){
  return `<div class="error">${msg}</div>`;
}

function head(station){
  return `
    <div class="station-head">
      <div>
        <h1>${station.name}</h1>
        <div class="desc">${station.desc}</div>
      </div>
      <div class="tag">${station.code}</div>
    </div>
  `;
}

function renderMain(){
  const main = document.getElementById('main');
  const station = STATIONS.find(s=>s.id===current);

  if(current === 'email') return renderEmail(main, station);
  if(current === 'meeting') return renderMeeting(main, station);
  if(current === 'tasks') return renderTasks(main, station);
  if(current === 'research') return renderResearch(main, station);
  if(current === 'chat') return renderChat(main, station);
}

/* ---------------- EMAIL ---------------- */
function renderEmail(main, station){
  main.innerHTML = head(station) + `
    <label>Recipient</label>
    <input type="text" id="e_recipient" placeholder="e.g. Kefiloe, my facilitator">
    <div class="row">
      <div>
        <label>Purpose</label>
        <input type="text" id="e_purpose" placeholder="e.g. request an extension">
      </div>
      <div>
        <label>Tone</label>
        <select id="e_tone">
          <option>Professional</option>
          <option>Friendly</option>
          <option>Formal</option>
          <option>Direct</option>
        </select>
      </div>
    </div>
    <label>Key points to include</label>
    <textarea id="e_points" placeholder="One per line — dates, context, what you need"></textarea>
    <button class="run-btn" id="e_run">Draft email</button>
    <div id="e_out"></div>
  `;
  document.getElementById('e_run').addEventListener('click', async ()=>{
    const recipient = document.getElementById('e_recipient').value.trim();
    const purpose = document.getElementById('e_purpose').value.trim();
    const tone = document.getElementById('e_tone').value;
    const points = document.getElementById('e_points').value.trim();
    const out = document.getElementById('e_out');
    if(!purpose && !points){ out.innerHTML = errorHtml('Add a purpose or a few key points first.'); return; }

    out.innerHTML = loadingHtml('Drafting email…');
    const btn = document.getElementById('e_run'); btn.disabled = true;
    try{
      const prompt = `Write an email.
Recipient: ${recipient || 'not specified'}
Purpose: ${purpose || 'not specified'}
Tone: ${tone}
Key points to include:
${points || 'none given — infer from purpose'}

Write only the email itself: a subject line, then the body. No preamble, no explanation before or after.`;
      const text = await callClaude({
        system:"You are a workplace writing assistant. Write clear, concise, well-structured emails. Output only the email (subject + body), nothing else.",
        messages:[{role:"user", content: prompt}]
      });
      out.innerHTML = ticketTemplate({label:'Drafted email', status:'Ready', bodyHtml: renderRichText(text)});
      wireCopy(text);
    }catch(err){
      out.innerHTML = errorHtml('Could not draft the email — ' + err.message);
    }finally{
      btn.disabled = false;
    }
  });
}

/* ---------------- MEETING ---------------- */
function renderMeeting(main, station){
  main.innerHTML = head(station) + `
    <label>Meeting notes or transcript</label>
    <textarea id="m_notes" style="min-height:220px" placeholder="Paste raw notes, chat transcript, or a rough recap here…"></textarea>
    <button class="run-btn" id="m_run">Summarize meeting</button>
    <div id="m_out"></div>
  `;
  document.getElementById('m_run').addEventListener('click', async ()=>{
    const notes = document.getElementById('m_notes').value.trim();
    const out = document.getElementById('m_out');
    if(!notes){ out.innerHTML = errorHtml('Paste some notes first.'); return; }
    out.innerHTML = loadingHtml('Reading through the notes…');
    const btn = document.getElementById('m_run'); btn.disabled = true;
    try{
      const prompt = `Summarize these meeting notes for a busy colleague. Structure the output as:
## Summary
(2-4 sentences)
## Key decisions
(bulleted, or "None recorded")
## Action items
(bulleted, with owner if mentioned)

Notes:
"""${notes}"""`;
      const text = await callClaude({
        system:"You summarize meeting notes accurately and concisely. Never invent details that aren't in the notes.",
        messages:[{role:"user", content: prompt}]
      });
      out.innerHTML = ticketTemplate({label:'Meeting summary', status:'Ready', bodyHtml: renderRichText(text)});
      wireCopy(text);
    }catch(err){
      out.innerHTML = errorHtml('Could not summarize — ' + err.message);
    }finally{
      btn.disabled = false;
    }
  });
}

/* ---------------- TASKS ---------------- */
function renderTasks(main, station){
  main.innerHTML = head(station) + `
    <label>What are you trying to get done?</label>
    <textarea id="t_goal" placeholder="e.g. Finish and submit both Unit Standard 114050 assessments by Monday 5pm"></textarea>
    <div class="row">
      <div>
        <label>Deadline (optional)</label>
        <input type="text" id="t_deadline" placeholder="e.g. Monday 24 Aug, 5:00 PM">
      </div>
      <div>
        <label>Detail level</label>
        <select id="t_detail">
          <option>Quick checklist</option>
          <option>Step-by-step with sub-tasks</option>
        </select>
      </div>
    </div>
    <button class="run-btn" id="t_run">Build task plan</button>
    <div id="t_out"></div>
  `;
  document.getElementById('t_run').addEventListener('click', async ()=>{
    const goal = document.getElementById('t_goal').value.trim();
    const deadline = document.getElementById('t_deadline').value.trim();
    const detail = document.getElementById('t_detail').value;
    const out = document.getElementById('t_out');
    if(!goal){ out.innerHTML = errorHtml('Describe the goal first.'); return; }
    out.innerHTML = loadingHtml('Breaking this down…');
    const btn = document.getElementById('t_run'); btn.disabled = true;
    try{
      const prompt = `Break this goal into an ordered, realistic task plan.
Goal: ${goal}
Deadline: ${deadline || 'not specified'}
Detail level: ${detail}

Output as a numbered list of tasks in the order they should be done. ${detail === 'Step-by-step with sub-tasks' ? 'Add 1-3 short sub-steps under each task where useful.' : 'Keep each task to one line.'} No preamble.`;
      const text = await callClaude({
        system:"You are a practical planning assistant. Produce realistic, ordered task lists — never vague or generic steps.",
        messages:[{role:"user", content: prompt}]
      });
      out.innerHTML = ticketTemplate({label:'Task plan', status:'Ready', bodyHtml: renderRichText(text)});
      wireCopy(text);
    }catch(err){
      out.innerHTML = errorHtml('Could not build the plan — ' + err.message);
    }finally{
      btn.disabled = false;
    }
  });
}

/* ---------------- RESEARCH ---------------- */
function renderResearch(main, station){
  main.innerHTML = head(station) + `
    <label>What do you want to look into?</label>
    <input type="text" id="r_query" placeholder="e.g. current entry-level civil engineering salaries in Johannesburg">
    <button class="run-btn" id="r_run">Research</button>
    <div id="r_out"></div>
  `;
  document.getElementById('r_run').addEventListener('click', async ()=>{
    const query = document.getElementById('r_query').value.trim();
    const out = document.getElementById('r_out');
    if(!query){ out.innerHTML = errorHtml('Enter a question first.'); return; }
    out.innerHTML = loadingHtml('Searching the web…');
    const btn = document.getElementById('r_run'); btn.disabled = true;
    try{
      const text = await callClaude({
        system:"You are a research assistant. Use web search to answer with current, accurate information. Cite sources by name inline (e.g. 'according to X'). Be concise and well-organized.",
        messages:[{role:"user", content: query}],
        tools:[{ type:"web_search_20250305", name:"web_search" }]
      });
      out.innerHTML = ticketTemplate({label:'Research findings', status:'Ready', bodyHtml: renderRichText(text)});
      wireCopy(text);
    }catch(err){
      out.innerHTML = errorHtml('Could not complete research — ' + err.message);
    }finally{
      btn.disabled = false;
    }
  });
}

/* ---------------- CHAT ---------------- */
function renderChat(main, station){
  main.innerHTML = head(station) + `
    <div class="chat-log" id="c_log"></div>
    <div class="chat-input-row">
      <textarea id="c_input" placeholder="Ask anything…"></textarea>
      <button class="run-btn" id="c_send">Send</button>
    </div>
  `;
  renderChatLog();

  document.getElementById('c_send').addEventListener('click', sendChat);
  document.getElementById('c_input').addEventListener('keydown', (e)=>{
    if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); sendChat(); }
  });

  function renderChatLog(){
    const log = document.getElementById('c_log');
    if(chatHistory.length === 0){
      log.innerHTML = `<div class="empty-note">No messages yet — this is a blank desk pad. Ask about anything: drafting, planning, general questions.</div>`;
      return;
    }
    log.innerHTML = chatHistory.map(m => `
      <div class="msg ${m.role}">
        <div class="who">${m.role === 'user' ? 'You' : 'Assistant'}</div>
        <div class="bubble">${m.role === 'assistant' ? renderRichText(m.content) : escapeHtml(m.content)}</div>
      </div>
    `).join('');
    log.scrollTop = log.scrollHeight;
  }

  function escapeHtml(s){
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  async function sendChat(){
    const input = document.getElementById('c_input');
    const text = input.value.trim();
    if(!text) return;
    chatHistory.push({role:'user', content:text});
    input.value = '';
    renderChatLog();

    const log = document.getElementById('c_log');
    const loadingId = 'chat_loading';
    log.insertAdjacentHTML('beforeend', `<div id="${loadingId}">${loadingHtml('Thinking…')}</div>`);
    log.scrollTop = log.scrollHeight;

    const sendBtn = document.getElementById('c_send'); sendBtn.disabled = true;
    try{
      const reply = await callClaude({
        system:"You are a helpful, concise workplace productivity assistant.",
        messages: chatHistory.map(m => ({role:m.role, content:m.content}))
      });
      chatHistory.push({role:'assistant', content:reply});
      renderChatLog();
    }catch(err){
      document.getElementById(loadingId)?.remove();
      log.insertAdjacentHTML('beforeend', errorHtml('Message failed — ' + err.message));
    }finally{
      sendBtn.disabled = false;
    }
  }
}

renderNav();
renderMain();
</script>

</body>
</html>
